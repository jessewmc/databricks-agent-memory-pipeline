# Copy to pi-memory/sidecar/.env for standalone runs:  cp ../.env.example sidecar/.env
# (the pi extension passes these as process env when it spawns the sidecar)

# Databricks auth (OAuth profile used for Lakebase psql + embeddings)
DATABRICKS_CONFIG_PROFILE=de_staging

# Provisioned Lakebase instance created by the bundle
LAKEBASE_INSTANCE_NAME=agent-memory-jesse-meade-clift
LAKEBASE_AGENT_MEMORY_SCHEMA=memories

# Embedding endpoint (must stay 1024-dim to match stored vectors)
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# Canonical, namespace-safe user id (NO periods/@ — LangGraph namespace rule).
# Must match ai_chatbot.Chat.userId written by the transcript writer (Phase 5).
PI_MEMORY_DEFAULT_USER_ID=jesse_meadeclift

# Sidecar listen port (localhost only)
PI_MEMORY_PORT=8765
